+        let tx_stats = self.tx_ring.get_tx_stats();
+        let rx_stats: Vec<_> = self.rx_rings.iter_mut()
+            .map(|ring| ring.get_provision_stats())
+            .collect();
+
+        InterfaceStats {
+            tx_stats,
+            rx_stats,
+            total_rx_rings: self.rx_rings.len() as u32,
+        }
+    }
