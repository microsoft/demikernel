demikernel:
  local_ipv4_addr: "{{IPADDR}}"
  local_link_addr: "{{MACADDR}}"
raw_socket:
  linux_interface_name: "{{abcde}}"
  xdp_interface_index: {{XDPIFIDX}}
  xdp_cohost_mode: true
  # Enable the following for XDP cohosting mode, or override in environment:
  xdp_tcp_ports: [6833]
  xdp_udp_ports: [1234, 4321]
  # Enable the following line if you have a VF interface
  # xdp_vf_interface_index: {{XDPVFIIDX}}
dpdk:
  eal_init: ["", "-c", "0xff", "-n", "4", "-a", "WW:WW.W","--proc-type=auto"]
tcp_socket_options:
  keepalive:
    enabled: false
    time_millis: 0
    interval: 0
  linger:
    enabled: true
    time_seconds: 0
  nodelay: true
inetstack_config:
  mtu: 1500
  mss: 1500
  enable_jumbo_frames: false
  udp_checksum_offload: false
  tcp_checksum_offload: false
  # arp_table:
  #   "{{MACADDR}}": "{{IPADDR}}"
  arp_request_retries: 5
  arp_request_timeout: 20
  arp_cache_ttl: 15

# vim: set tabstop=2 shiftwidth=2
